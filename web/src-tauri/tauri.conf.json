{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Novelia 轻小说机翻机器人",
  "mainBinaryName": "Novelia",
  "version": "0.2.0",
  "identifier": "cc.novelia.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Novelia Client",
    "copyright": "GPL-3.0",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Novelia 轻小说机翻机器人",
    "longDescription": "Novelia 轻小说机翻机器人",
    "externalBin": ["binaries/ech-proxy"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "installer.nsi",
        "languages": ["SimpChinese"]
      }
    },
    "resources": {
      "icons/icon.ico": "novelia-q.ico",
      "../../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
